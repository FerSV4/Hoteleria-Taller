{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Hotelería - ISW",
    "version": "1.0.0",
    "description": "Documentación endpoints Hoteleria"
  },
  "paths": {
    "/api/habitaciones/tipos": {
      "get": {
        "summary": "Obtener tipos de habitaciones existentes",
        "tags": ["Habitaciones"],
        "responses": {
          "200": { "description": "OK" },
          "500": { "description": "Error del servidor" }
        }
      }
    },
    "/api/reservas/": {
      "get": {
        "summary": "Obtener lista de reservas globales",
        "tags": ["Reservas"],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/contactos": {
      "get": {
        "summary": "Obtener lista de contactos (servicios hotel)",
        "tags": ["Contactos"],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    }
  }
}